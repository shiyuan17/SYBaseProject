IMAGE_REPO=registry.example.com/group/project/bl-center
IMAGE_TAG=develop
CONTAINER_NAME=sybase-bl-center
HOST_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
BL_CENTER_DATASOURCE_DRIVER_CLASS_NAME=dm.jdbc.driver.DmDriver
BL_CENTER_DATASOURCE_URL=jdbc:dm://127.0.0.1:5236
BL_CENTER_DATASOURCE_USERNAME=SYSDBA
BL_CENTER_DATASOURCE_PASSWORD=Dm.2027.Pwd.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=
SPRING_FLYWAY_BASELINE_VERSION=
SPRING_FLYWAY_BASELINE_DESCRIPTION=
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseContainerSupport
TZ=Asia/Shanghai
APP_DATA_DIR=/opt/sybase/bl-center/data
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
