IMAGE_REPO=sybase-bl-center
IMAGE_TAG=local
CONTAINER_NAME=sybase-bl-center-local
HOST_PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=test
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseContainerSupport
TZ=Asia/Shanghai
APP_DATA_DIR=./data-local
BL_REPORT_OFD_ENABLED=true
BL_REPORT_STORAGE_ROOT=/data/reports
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
